  m_Name: 
  m_EditorClassIdentifier: 
  _ru: "\u042D\u0442\u0430 \u0418\u0433\u0440\u0430 \u043F\u0440\u043E \u043E\u0447\u0435\u043D\u044C
    \u043E\u0431\u0436\u043E\u0440\u043B\u0438\u0432\u0443\u044E \u043B\u044F\u0433\u0443\u0448\u043A\u0443,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043C\u0435\u0447\u0442\u0430\u0435\u0442
    \u0441\u044A\u0435\u0441\u0442\u044C \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E
    \u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u0443\u0445. \u0427\u0442\u043E\u0431\u044B
    \u043F\u043E\u043C\u043E\u0447\u044C \u0435\u0439 \u0441 \u044D\u0442\u0438\u043C,
    \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u043B\u0438\u043A\u0430\u0439 \u043D\u0430
    \u044D\u043A\u0440\u0430\u043D \u0438 \u043C\u0443\u0445\u0438 \u0441\u0430\u043C\u0438
    \u0431\u0443\u0434\u0443\u0442 \u043B\u0435\u0442\u0435\u0442\u044C \u0435\u0439
    \u0432 \u0440\u043E\u0442."
  _en: '

    This game is about a very gluttonous frog who dreams of eating as many
    flies as possible. To help her with this, just click on the screen and the flies
    will fly into her mouth.'
